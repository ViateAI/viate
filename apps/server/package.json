{
  "name": "@viateai/server",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@viateai/plugin-manager": "workspace:*",
    "@viateai/sdk": "workspace:*",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
