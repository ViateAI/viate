HOST=
PORT=
VIATE_DATA_DIR=
# VIATE_ADMIN_PASSWORD must be set or the admin API stays unavailable, and compose.yaml interpolates it.
VIATE_ADMIN_PASSWORD=
VIATE_ADMIN_UI_DIST=
VIATE_PNPM=
# Who may set X-Forwarded-For. Default trusts loopback and private ranges. false if clients connect directly.
VIATE_TRUST_PROXY=loopback,uniquelocal
# Per-user cap on requests in flight.
VIATE_USER_MAX_INFLIGHT=8
# Set to true to store prompt and response bodies. Default off.
VIATE_LOG_PAYLOADS=
# Days to keep request logs and any stored bodies.
VIATE_REQUEST_LOG_RETENTION_DAYS=7
# EPay-compatible top-up. Leave all of these empty to disable it. Do not put a real key here.
VIATE_EPAY_ENDPOINT=
VIATE_EPAY_PID=
VIATE_EPAY_KEY=
VIATE_EPAY_PUBLIC_BASE=
VIATE_EPAY_TYPE=
VIATE_EPAY_CURRENCY=
VIATE_EPAY_QUOTE_PER_USD=
VIATE_EPAY_USD_AMOUNTS=
VIATE_EPAY_PAY_HOSTS=
VIATE_EPAY_DEVICE=
VIATE_EPAY_ORDER_TTL_SECONDS=
VIATE_EPAY_TIMEOUT_MS=
