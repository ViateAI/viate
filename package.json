{
  "name": "viate",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24",
    "pnpm": "9.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @viateai/server dev",
    "dev:web": "pnpm --filter @viateai/web dev",
    "build": "pnpm -r --filter @viateai/sdk --filter @viateai/plugin-manager --filter @viateai/cli --filter @viateai/web --filter @viateai/server build",
    "start": "pnpm --filter @viateai/server start",
    "viate": "pnpm --filter @viateai/cli run viate --",
    "typecheck": "pnpm -r --filter @viateai/sdk --filter @viateai/plugin-manager --filter @viateai/cli --filter @viateai/web --filter @viateai/server typecheck",
    "test": "pnpm -r --filter @viateai/sdk --filter @viateai/plugin-manager --filter @viateai/cli --filter @viateai/server test"
  }
}
